{
  "expo": {
    "name": "NESBA",
    "slug": "nesba",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "nesba",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F1220"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nesba.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0F1220"
      },
      "package": "com.nesba.app"
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-audio",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "NESBA uses your location only when you choose to add it to a story."
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
